# ============================================
# DOCKERFILE PARA FRONTEND - TECHACCESS
# ============================================

# ------- BUILD -------
FROM node:20-alpine AS build

WORKDIR /app

# Copiar dependencias
COPY package*.json ./
RUN npm install

# Copiar código fuente
COPY . .

# Construir el proyecto
RUN npx ng build --configuration=production

# ------- PRODUCCIÓN -------
FROM nginx:alpine

# 🔑 VERIFICAR LA RUTA CORRECTA
# Si el build está en dist/adso_3063267
COPY --from=build /app/dist/adso_3063267/browser /usr/share/nginx/html

# Si el build está en dist/browser
# COPY --from=build /app/dist/browser /usr/share/nginx/html

# Configurar nginx para SPA
RUN echo 'server { \
    listen 80; \
    server_name localhost; \
    root /usr/share/nginx/html; \
    index index.html; \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]